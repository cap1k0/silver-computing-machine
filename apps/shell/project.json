{
  "name": "shell",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/shell",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "next build --no-turbopack", "cwd": "apps/shell" }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": { "command": "next dev --port 3001", "cwd": "apps/shell" }
    },
    "start": {
      "executor": "nx:run-commands",
      "options": { "command": "next start", "cwd": "apps/shell" }
    }
  },
  "tags": ["scope:shell"]
}
